{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "MathFinder Design Tokens",
  "version": "0.1.0",
  "references": ["https://math-olymp.rudn.ru/", "https://do.bmstu.ru/"],
  "color": {
    "violet": {
      "50":  { "$value": "#f4f1fe" },
      "100": { "$value": "#e9e3fd" },
      "200": { "$value": "#d4c9fa" },
      "300": { "$value": "#b7a4f4" },
      "400": { "$value": "#9a83ec" },
      "500": { "$value": "#7c64dd", "$description": "brand, из RUDN" },
      "600": { "$value": "#6a4fd0" },
      "700": { "$value": "#573fb0" },
      "800": { "$value": "#46338c" },
      "900": { "$value": "#382a6e" }
    },
    "orange": {
      "50":  { "$value": "#fff6ec" },
      "100": { "$value": "#ffe9d1" },
      "200": { "$value": "#ffd2a3" },
      "300": { "$value": "#ffaf60", "$description": "accent, из RUDN" },
      "400": { "$value": "#fb9430" },
      "500": { "$value": "#e07d01", "$description": "из BMSTU" },
      "600": { "$value": "#b96500" },
      "700": { "$value": "#8f4e00" }
    },
    "blue": {
      "50":  { "$value": "#eaf3fb" },
      "100": { "$value": "#d3e5f6" },
      "200": { "$value": "#a8caec" },
      "300": { "$value": "#6ea9df" },
      "400": { "$value": "#3587cf" },
      "500": { "$value": "#065bab", "$description": "BMSTU blue" },
      "600": { "$value": "#004e9f" },
      "700": { "$value": "#003d7d" },
      "800": { "$value": "#002d5c" },
      "900": { "$value": "#001f40" }
    },
    "gray": {
      "0":   { "$value": "#ffffff" },
      "25":  { "$value": "#fafafa", "$description": "page bg (BMSTU)" },
      "50":  { "$value": "#f5f5f7" },
      "100": { "$value": "#eeeef1" },
      "200": { "$value": "#e2e2e8" },
      "300": { "$value": "#c9c9c9", "$description": "border (RUDN)" },
      "400": { "$value": "#a3a3ad" },
      "500": { "$value": "#7a7a85" },
      "600": { "$value": "#55555f" },
      "700": { "$value": "#3a3a42" },
      "800": { "$value": "#232329" },
      "900": { "$value": "#141418" }
    },
    "semantic": {
      "success": { "$value": "#17976a" },
      "successBg": { "$value": "#caf4e3" },
      "warning": { "$value": "#c98a00" },
      "warningBg": { "$value": "#ffefcd" },
      "danger":  { "$value": "#d92d20" },
      "dangerDark": { "$value": "#ad0000" },
      "dangerBg": { "$value": "#ffcdcd" }
    },
    "aliases": {
      "brand":        { "$value": "{color.violet.500}" },
      "brandHover":   { "$value": "{color.violet.600}" },
      "brandSoft":    { "$value": "{color.violet.50}" },
      "accent":       { "$value": "{color.orange.300}" },
      "link":         { "$value": "{color.blue.500}" },
      "bgPage":       { "$value": "{color.gray.25}" },
      "bgSurface":    { "$value": "{color.gray.0}" },
      "textPrimary":  { "$value": "{color.gray.900}" },
      "textSecondary":{ "$value": "{color.gray.600}" },
      "borderDefault":{ "$value": "{color.gray.200}" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$value": "Inter, TildaSans, Gilroy, -apple-system, Segoe UI, Arial, sans-serif" },
      "mono": { "$value": "JetBrains Mono, SF Mono, Consolas, monospace" }
    },
    "fontSize": {
      "xs":   { "$value": "12px" },
      "sm":   { "$value": "14px" },
      "base": { "$value": "16px" },
      "lg":   { "$value": "18px" },
      "xl":   { "$value": "20px" },
      "2xl":  { "$value": "24px" },
      "3xl":  { "$value": "30px" },
      "4xl":  { "$value": "36px" },
      "5xl":  { "$value": "56px" }
    },
    "lineHeight": { "tight": { "$value": 1.2 }, "normal": { "$value": 1.55 } },
    "letterSpacing": { "heading": { "$value": "-0.02em" } },
    "fontWeight": { "regular": 400, "semibold": 600, "bold": 700, "extrabold": 800 }
  },
  "spacing": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px",
    "20": "80px", "24": "96px"
  },
  "radius": {
    "sm":   { "$value": "6px",  "$description": "inputs, chips" },
    "md":   { "$value": "10px", "$description": "cards (BMSTU)" },
    "lg":   { "$value": "16px", "$description": "panels, hero" },
    "pill": { "$value": "999px","$description": "buttons (BMSTU 40px)" },
    "full": { "$value": "50%" }
  },
  "shadow": {
    "xs": { "$value": "0 1px 2px rgba(20,20,24,.06)" },
    "sm": { "$value": "0 1px 3px rgba(20,20,24,.08), 0 1px 2px rgba(20,20,24,.05)" },
    "md": { "$value": "0 4px 12px rgba(20,20,24,.09)" },
    "lg": { "$value": "0 12px 32px rgba(20,20,24,.13)" }
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing":   { "standard": "cubic-bezier(.2,.7,.3,1)" }
  },
  "layout": {
    "container": { "$value": "1200px" },
    "headerHeight": { "$value": "64px" },
    "breakpoints": { "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px" }
  }
}
